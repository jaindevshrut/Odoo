# Server Configuration
PORT=8000

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
# or for MongoDB Atlas:
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net

# CORS Configuration
CORS_ORIGIN=*
# In production, specify exact origins:
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# JWT Token Configuration
ACCESS_TOKEN_SECRET=your_access_token_secret_here_use_long_random_string
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_use_different_long_random_string
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLODINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit the .env file to version control
# 3. Generate strong random strings for token secrets (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# 4. For Cloudinary credentials, sign up at https://cloudinary.com and get them from your dashboard
